DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret

# GitHub OAuth (optional). Use in authenticated deployments for "Connect GitHub".
# OAuth app callback: {public origin}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: PAT for local-trusted dev (`local-board`) when OAuth is not mounted.
PAPERCLIP_GITHUB_PAT=

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
